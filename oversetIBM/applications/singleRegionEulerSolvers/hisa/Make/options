ifeq (v,$(WM_PROJECT_VERSION:v%=v))
    VER_1712 := $(shell expr $(WM_PROJECT_VERSION) \>= v1712)
    ifeq ($(VER_1712), 1)
        FOAM_VERSION = -DFOAM_VERSION_1712
    endif
else
    VER_6 := $(shell expr $(WM_PROJECT_VERSION) \>= 6)
    ifeq ($(VER_6), 1)
        FOAM_VERSION = -DFOAM_VERSION_6
    endif
endif

EXE_INC = \
    $(FOAM_VERSION) \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I../../../src/modules/solver/lnInclude \
    -I../../../src/modules/hisa/lnInclude \
    -I../../../src/solvers/lnInclude

EXE_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(FOAM_USER_LIBBIN) \
    -lsolverModule \
    -lhisaModule \
    -lhisaSolvers

