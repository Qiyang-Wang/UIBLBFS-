inline double Foam::hisaModule::assoc(label i_Lag, label i_Euler)
{
    const fvMesh& mesh = meshParts_[0].subMesh();
    //fvMesh& mesh = mesh_();

    double rx = fabs(mesh.C()[i_Euler].x()-solidObject_[i_Lag].x)/h_;
    double ry = fabs(mesh.C()[i_Euler].y()-solidObject_[i_Lag].y)/h_;
    
    return deltaFunc(rx)*deltaFunc(ry);
}

inline double Foam::hisaModule::deltaFunc(double r)
{
    double deltaFunc = 0;
    double absR = fabs(r);
    if(absR <= 1)
    {
        deltaFunc = (3-2*absR+sqrt(1+4*absR-4*absR*absR))/8.;
    } else if(absR <= 2)
    {
        deltaFunc = (5-2*absR-sqrt(-7+12*absR-4*absR*absR))/8.;
    } else
    {
        deltaFunc = 0;
    }

    return deltaFunc;
}

inline void Foam::hisaModule::readLagragianPoints()
{
    double refD = 1.0;
    double deltaTheta;
    double PI = 3.14159265359;

    h_ = 5./100;//2.5/1000;
    N_L=225/5;

    solidObject_ = List<SolidObject>(N_L);

    deltaTheta = 2*PI/(N_L);

    for(int i = 0; i<N_L; i++)
    {    
        solidObject_[i].x = refD*cos(deltaTheta*i)/2.;
        solidObject_[i].y = refD*sin(deltaTheta*i)/2.;
        solidObject_[i].u = 0;
        solidObject_[i].v = 0;
    }

//    for(int i = 0; i<N_L; i++)
//    {   
//        Info << solidObject_[i].x<< " " <<solidObject_[i].y<< endl;
//    }
//    Info << "0" << endl;
//    cin.get();

    D_ = List<List<double>>(N_L);
    DCellID_ = List<List<int>>(N_L);
    hostCell_ = List<int>(N_L);
    //*****************************start overset****************************// 
    const fvMesh& mesh_whole = mesh_();
    zoneID_.set(&(mesh_whole.lookupObject<labelIOList>("zoneID")));
    const labelIOList& zoneID = zoneID_(); 
   
    //find the moving zone 
    oversetZoneID_ = 1;
    //const fvBoundaryMesh& fvm = mesh_whole.boundary();
    //// 'overset' patches
    //forAll(fvm, patchI)
    //{
    //    if (isA<oversetFvPatch>(fvm[patchI]))
    //    {
    //         const labelList& fc = fvm[patchI].faceCells();
    //         label cell0 = fc[0];
    //         oversetZoneID_ = zoneID[cell0];
    //     }
    //}

    meshParts_.setSize(1);
    meshParts_.set
    (
        0,
        new fvMeshSubset(mesh_whole)
    );
    meshParts_[0].setLargeCellSubset(static_cast<labelList>(zoneID_), oversetZoneID_); 

    const fvMesh& mesh = meshParts_[0].subMesh();
//    Info<< meshParts_[0].cellMap() <<endl;
//    Info<< oversetZoneID_ <<endl;
//    cin.get();
//    fvMesh& mesh = mesh_();
    //*****************************end overset****************************// 
    neighbourCells_ = List<NeighbourCells>(mesh.C().size());

    for(int j = 0; j<mesh.C().size(); j++)
    {
	neighbourCells_[j].w_=-1;
	neighbourCells_[j].e_=-1;
	neighbourCells_[j].n_=-1;
	neighbourCells_[j].s_=-1;

	const labelList& cells = mesh.cellCells()[j];
        forAll(cells, idx)
	{
            label cell = cells[idx];
            vector direction = mesh.cellCentres()[cell] - mesh.cellCentres()[j];
            direction = direction/mag(direction);
	    if(direction.x()>0.5)
	    {
		neighbourCells_[j].e_=cell;
	    } else if(direction.x()<-0.5) {
		neighbourCells_[j].w_=cell;
	    } else if(direction.y()>0.5) {
		neighbourCells_[j].n_=cell;
	    } else if(direction.y()<-0.5) {
		neighbourCells_[j].s_=cell;
	    }
	}
    }

//    for(int j = 0; j<mesh.C().size(); j++)
//    {
//	if ((mag(mesh.cellCentres()[j].x())<0.6) && (mag(mesh.cellCentres()[j].y())<0.8)) {
//            Info << j << "    "
//            << neighbourCells_[j].w_ << "    "
//            << neighbourCells_[j].e_<< "    "
//            << neighbourCells_[j].n_<< "    "
//            << neighbourCells_[j].s_<< "    "
//	    << endl;
//	    if(neighbourCells_[j].w_<0)
//	    {
//	    	Info<<"*********************" << endl;
//	    	Info<< mesh.cellCells()[j] << endl;
//	    }
//	}
//
//    }
//    cin.get();


    for(int i = 0; i<N_L; i++)
    {
        int N_nonzero = 0;
        for(int j = 0; j<mesh.C().size(); j++)
        {
            double rx = fabs(mesh.C()[j].x()-solidObject_[i].x)/h_;
            double ry = fabs(mesh.C()[j].y()-solidObject_[i].y)/h_;
            if ( (rx<2) && (ry<2))
	    {
                N_nonzero++;
            }
        }
        D_[i] = List<double>(N_nonzero);
        DCellID_[i] = List<int>(N_nonzero);
    }

    for(int i = 0; i<N_L; i++)
    {
        int N_nonzero = 0;
        for(int j = 0; j<mesh.C().size(); j++)
        {
            double rx = fabs(mesh.C()[j].x()-solidObject_[i].x)/h_;
            double ry = fabs(mesh.C()[j].y()-solidObject_[i].y)/h_;
            if ( (rx<2) && (ry<2))
	    {
                D_[i][N_nonzero] = deltaFunc(rx)*deltaFunc(ry);
                DCellID_[i][N_nonzero] = j; 
                N_nonzero++;
            }
        }
	point location(0,0,0);
	location.x() = solidObject_[i].x;
	location.y() = solidObject_[i].y;
	hostCell_[i] = findNearestCell(location, 0);
    }

    deltaU_ = vectorField(mesh_->C().size(), vector(0, 0, 0));

    I_ = PI*refD*refD/64.;
    M_ = 1.25*PI*(refD*refD/4.);
    rhoS_ = 1.25;
    rhoF_ = 1;

    g_ = 9.8*0.4823;

    xc_ =0;
    yc_ =0;

    ut_ = 0;
    vt_ = 0;
    vt_o_ = 0;
    omega_ = 0;

    desiredProperties();

    //initialization for traditional IBM
    A_ = List<List<scalar>>(N_L);
    
    //form A matrix
    for(int i = 0; i<N_L; i++)
    {
        A_[i] = List<scalar>(N_L);
    }

    Info<<"IBM initialization done." << endl;
}

inline void Foam::hisaModule::desiredProperties()
{
    Ub_ = vectorField(N_L, vector(0, 0, 0));
    Tb_ = scalarField(N_L,.25);
}

inline void Foam::hisaModule::calcB(int cmpt)
{
    volVectorField& U = U_();
	
    for(int i = 0; i<N_L; i++)
    {
        double rowSum = 0;
        for(int j = 0; j<D_[i].size(); j++)
        {
            double u = U.internalField()[DCellID_[i][j]].component(cmpt);
            rowSum += D_[i][j]*u;
            //label n_euler = DCellID_[i][j];
            //rowSum += assoc(i,n_euler)*u;
        }
        B_[i] = Ub_[i].component(cmpt) - rowSum;
    }
}

inline void Foam::hisaModule::GSsolve
(
    scalarField& psi,
    const scalarField& source
)
{
    List<List<scalar>> A;
    A = List<List<scalar>>(N_L);
    
    //form A matrix
    for(int i = 0; i<N_L; i++)
    {
        A[i] = List<scalar>(N_L);
        for(int j = 0; j<N_L; j++)
        {
            double sum = 0;
            for(int k = 0; k<D_[i].size(); k++)
            {
		label n_euler = DCellID_[i][k];
                sum +=assoc(i,n_euler)*assoc(j,n_euler);
	    }
            A[i][j] = sum;
        }
    }
    
    //solve Ax=b using GS
    label iters = 100000;
    int i=0;
    //scalar normFactor = gSum(B_);
    scalarField pA(N_L);
    const scalar normFactor = calcNormFactor(X_, B_, X_, pA);

    scalar deltaSum_init = 0;
    for(int j=0; j<N_L;j++)
    {
        scalar Ax = 0;
        for(int k=0; k<N_L;k++)
        {
            Ax += A[j][k]*X_[k];
        }
        scalar delta = (B_[j]- Ax);
        deltaSum_init += mag(delta);
    }
    
    //std::ofstream outfile;
    //outfile.open("residual.txt", std::ios_base::app);
    Info << normFactor << endl;
    Info << deltaSum_init << endl;

    if (deltaSum_init>(1e-5*normFactor))
    {
        for(i=0; i<iters;i++)
        {
            scalar deltaSum = 0;
            for(int j=0; j<N_L;j++)
            {
                scalar Ax = 0;
                for(int k=0; k<N_L;k++)
                {
                    Ax += A[j][k]*X_[k];
                }
                scalar delta = (B_[j]- Ax);
                X_[j] = delta/A[j][j]+ X_[j];
                deltaSum += mag(delta);
            }
	    //outfile << i << "    "<< deltaSum<< "\n";
            if (deltaSum<(1e-5*normFactor))
            {
                break;
            }
        }
    }

    if (i<iters)
    {
        Info << "IBM solved by GS within "
             << i
             << " iterations with relTol 1e-5"
             << endl;
    } else 
    {
        Info << "IBM NOT solved by GS within "
             << i
             << " iterations with relTol 1e-5"
             << endl;
	cin.get();
    }
}

inline void Foam::hisaModule::initialGuessX()
{
    for(int i = 0; i<N_L; i++)
    {
	X_[i] = 0;
    }
}

inline void Foam::hisaModule::formA()
{
    //form A matrix
    for(int i = 0; i<N_L; i++)
    {
        for(int j = 0; j<N_L; j++)
        {
            double sum = 0;
            for(int k = 0; k<D_[i].size(); k++)
            {
		label n_euler = DCellID_[i][k];
                sum +=assoc(i,n_euler)*assoc(j,n_euler);
	    }
            A_[i][j] = sum;
        }
    }
}


inline void Foam::hisaModule::Amul(scalarField& wA, scalarField& psi)
{

    const fvMesh& mesh = meshParts_[0].subMesh();
    scalarField x_star(mesh.C().size(), 0);

    for(int i = 0; i<N_L; i++)
    {
        for(int j = 0; j<D_[i].size(); j++)
        {
            double rowSum = D_[i][j]*psi[i];
            x_star[DCellID_[i][j]] += rowSum;
        }
    }

    for(int i = 0; i<N_L; i++)
    {
        double rowSum = 0;
        for(int j = 0; j<D_[i].size(); j++)
        {
            rowSum += D_[i][j]*x_star[DCellID_[i][j]];
        }
        wA[i] = rowSum;
    }
    
	/*
    for(int i = 0; i<N_L; i++)
    {
        double rowSum = 0;
        for(int j = 0; j<N_L; j++)
        {
            double sum = 0;
            for(int k = 0; k<D_[i].size(); k++)
            {
		label n_euler = DCellID_[i][k];
                sum +=assoc(i,n_euler)*assoc(j,n_euler);
	    }
            rowSum += sum*psi[i];
        }
        wA[i] = rowSum;
    }*/

/*    
    for(int i = 0; i<N_L; i++)
    {
        double rowSum = 0;
        for(int j = 0; j<N_L; j++)
        {
            rowSum += A_[i][j]*psi[j];
        }
        wA[i] = rowSum;
    } 
 */   
}

inline void Foam::hisaModule::Tmul(scalarField& wA, scalarField& psi)
{
    Amul(wA, psi);
}

