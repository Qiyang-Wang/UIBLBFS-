void lbfsScheme::lbfs_D1Q4
(
    scalar s1x,
    scalar s1y,
    scalar s1z,
    scalar rho_L,
    scalar rho_R,
    vector U_L,
    vector U_R,
    scalar p_L,
    scalar p_R,
    scalar& F_1, 
    vector& F_24, 
    scalar& F_5
)
{
    scalar Dim = 1;
    scalar gamma = 1.4;
//    scalar C = 340.2626;//sqrt(1.4*288.15*287)
//    scalar rho2p = C*C;

    //Primitive variables [density, x-velocity, y-velocity, z-velocity, pressure]
    scalar dl = rho_L; 
    scalar uul= U_L.x();
    scalar vvl= U_L.y();
    scalar wwl= U_L.z();
//    scalar pl = rho_L*rho2p;
    scalar pl = p_L;
    scalar dr = rho_R; 
    scalar uur= U_R.x();
    scalar vvr= U_R.y();
    scalar wwr= U_R.z();
//    scalar pr = rho_R*rho2p;
    scalar pr = p_R;

    //Switch factor, use for controlling numerical dissipation 
//    scalar ParaA= 0.1;
//    scalar ParaA = 0;//tanh(10*abs(pl-pr)/(pl+pr));
    scalar ParaA = tanh(10*abs(pl-pr)/(pl+pr));

    scalar hl=gamma*pl/((gamma-1.)*dl)+0.5*(uul*uul+vvl*vvl+wwl*wwl);
    scalar hr=gamma*pr/((gamma-1.)*dr)+0.5*(uur*uur+vvr*vvr+wwr*wwr);
   
    //----Roe average--------------------
    scalar tmpp=sqrt(dr/dl);
    scalar avd=0.25*dl*(1.+tmpp)*(1.+tmpp);
    scalar avu=(uul+tmpp*uur)/(1.+tmpp);
    scalar avv=(vvl+tmpp*vvr)/(1.+tmpp);
    scalar avw=(wwl+tmpp*wwr)/(1.+tmpp);
    scalar avh=(hl+tmpp*hr)/(1.+tmpp);
    scalar avc=sqrt(Dim*(avh-0.5*(avu*avu+avv*avv+avw*avw))*(gamma-1.)/gamma);
    scalar avn=avu*s1x+avv*s1y+avw*s1z;
    scalar vnl=uul*s1x+vvl*s1y+wwl*s1z;
    scalar vnr=uur*s1x+vvr*s1y+wwr*s1z;
    
    scalar vtl[3],vtr[3];
    vtl[0]=uul-vnl*s1x;
    vtl[1]=vvl-vnl*s1y;
    vtl[2]=wwl-vnl*s1z;
    vtr[0]=uur-vnr*s1x;
    vtr[1]=vvr-vnr*s1y;
    vtr[2]=wwr-vnr*s1z;
        
    //particle velocities
    scalar d1=sqrt(avn*avn+3.*avc*avc-sqrt(4.*avn*avn*avc*avc+6.*avc*avc*avc*avc));
    scalar d2=sqrt(avn*avn+3.*avc*avc+sqrt(4.*avn*avn*avc*avc+6.*avc*avc*avc*avc));
    //
    scalar epl;
    scalar epr;
    scalar NodeL[4],NodeR[4];

    feq_d1q4(1,dl,vnl,pl,gamma,NodeL,d1,d2,epl);
    feq_d1q4(2,dr,vnr,pr,gamma,NodeR,d1,d2,epr);

    //********************************Scheme II (large numerical dissipation)************************************
    scalar FL[5], FR[5];

    FL[0]=NodeL[0]*d1+NodeL[2]*d2;
    FL[1]=(NodeL[0]*d1*d1+NodeL[2]*d2*d2)*s1x+FL[0]*vtl[0];
    FL[2]=(NodeL[0]*d1*d1+NodeL[2]*d2*d2)*s1y+FL[0]*vtl[1];
    FL[3]=(NodeL[0]*d1*d1+NodeL[2]*d2*d2)*s1z+FL[0]*vtl[2];
    FL[4]=d1*NodeL[0]*(0.5*d1*d1+epl)+d2*NodeL[2]*(0.5*d2*d2+epl)+0.5*FL[0]*(vtl[0]*vtl[0]+vtl[1]*vtl[1]+vtl[2]*vtl[2]);

    FR[0]=NodeR[1]*(-d1)+NodeR[3]*(-d2);
    FR[1]=(NodeR[1]*d1*d1+NodeR[3]*d2*d2)*s1x+FR[0]*vtr[0];
    FR[2]=(NodeR[1]*d1*d1+NodeR[3]*d2*d2)*s1y+FR[0]*vtr[1];
    FR[3]=(NodeR[1]*d1*d1+NodeR[3]*d2*d2)*s1z+FR[0]*vtr[2];
    FR[4]=(-d1)*NodeR[1]*(0.5*d1*d1+epr)+(-d2)*NodeR[3]*(0.5*d2*d2+epr)+0.5*FR[0]*(vtr[0]*vtr[0]+vtr[1]*vtr[1]+vtr[2]*vtr[2]);

    scalar F2[5];
    for(int n = 0; n < 5; n++)
    {
        F2[n]=FL[n]+FR[n];
    }
    //***********************************************************************************************************

    //******************************Scheme I (less numerical dissipation)****************************************
    FL[0]=NodeL[0]+NodeL[2];
    FL[1]=(NodeL[0]*d1+NodeL[2]*d2)*s1x+FL[0]*vtl[0];
    FL[2]=(NodeL[0]*d1+NodeL[2]*d2)*s1y+FL[0]*vtl[1];
    FL[3]=(NodeL[0]*d1+NodeL[2]*d2)*s1z+FL[0]*vtl[2];
    FL[4]=NodeL[0]*(0.5*d1*d1+epl)+NodeL[2]*(0.5*d2*d2+epl)+0.5*FL[0]*(vtl[0]*vtl[0]+vtl[1]*vtl[1]+vtl[2]*vtl[2]);

    FR[0]=NodeR[1]+NodeR[3];
    FR[1]=(NodeR[1]*(-d1)+NodeR[3]*(-d2))*s1x+FR[0]*vtr[0];
    FR[2]=(NodeR[1]*(-d1)+NodeR[3]*(-d2))*s1y+FR[0]*vtr[1];
    FR[3]=(NodeR[1]*(-d1)+NodeR[3]*(-d2))*s1z+FR[0]*vtr[2];
    FR[4]=NodeR[1]*(0.5*d1*d1+epr)+NodeR[3]*(0.5*d2*d2+epr)+0.5*FR[0]*(vtr[0]*vtr[0]+vtr[1]*vtr[1]+vtr[2]*vtr[2]);

    scalar W[5];
    for(int n = 0; n < 5; n++)
    {
        W[n]=FL[n]+FR[n];
    }

    scalar d =W[0];
    scalar uu=W[1]/d;
    scalar vv=W[2]/d;
    scalar ww=W[3]/d;
    scalar vn=uu*s1x+vv*s1y+ww*s1z;
    scalar p =(W[4]-0.5*d*(uu*uu+vv*vv+ww*ww))*(gamma-1.);
    scalar F1[5];
    F1[0]=d*vn;
    F1[1]=d*vn*uu+p*s1x;
    F1[2]=d*vn*vv+p*s1y;
    F1[3]=d*vn*ww+p*s1z;
    F1[4]=(W[4]+p)*vn;	
    //***********************************************************************************************************

    //******************************Scheme III (moderately numerical dissipation)********************************
    F_1      = ((1.-ParaA)*F1[0]+ParaA*F2[0]);
    F_24.x() = ((1.-ParaA)*F1[1]+ParaA*F2[1]);
    F_24.y() = ((1.-ParaA)*F1[2]+ParaA*F2[2]);
    F_24.z() = ((1.-ParaA)*F1[3]+ParaA*F2[3]);
    F_5      = ((1.-ParaA)*F1[4]+ParaA*F2[4]);

}

void lbfsScheme::feq_d1q4
(
    int side,
    scalar rou,
    scalar uu,
    scalar p,
    scalar gamma,
    scalar node[4],
    scalar d1,
    scalar d2,
    scalar &ep
)
{
    scalar Dim = 1;

    scalar en=p/rou/(gamma-1.);
    scalar c=sqrt(Dim*(gamma-1.)*en);     	
    ep=(1-0.5*Dim*(gamma-1.))*en;	  //Microscopic potential energy
    scalar a12=2*d1*(d1*d1-d2*d2);
    scalar a34=2*d2*(d1*d1-d2*d2);
    
    scalar d[4];	
    if(side==1) {
	d[0]=-d1*d2*d2-d2*d2*uu+d1*uu*uu+d1*c*c+uu*uu*uu+3.*uu*c*c;
	d[2]= d2*d1*d1+d1*d1*uu-d2*uu*uu-d2*c*c-uu*uu*uu-3.*uu*c*c;
	node[0]=rou*d[0]/a12;
	node[2]=rou*d[2]/a34;
    }
    else if(side==2) {
    	d[1]=-d1*d2*d2+d2*d2*uu+d1*uu*uu+d1*c*c-uu*uu*uu-3.*uu*c*c;
	d[3]= d2*d1*d1-d1*d1*uu-d2*uu*uu-d2*c*c+uu*uu*uu+3.*uu*c*c;
	node[1]=rou*d[1]/a12;
	node[3]=rou*d[3]/a34;
    }
}

