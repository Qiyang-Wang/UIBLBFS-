template<class Type>
void Foam::lbfsScheme::recon
(
    const GeometricField<Type, fvPatchField, volMesh>& vf,
    tmp<GeometricField<Type, fvsPatchField, surfaceMesh>>& tsf_L,
    tmp<GeometricField<Type, fvsPatchField, surfaceMesh>>& tsf_R
)
{
    if (surfaceInterpolation::debug)
    {
        InfoInFunction
            << "Reconstructing left and right states of "
            << vf.type() << " "
            << vf.name()
            << " from cells to faces"
            << endl;
    }

    const Field<Type>& vfi = vf;

    const fvMesh& mesh = vf.mesh();
    const labelUList& P = mesh.owner();
    const labelUList& N = mesh.neighbour();

    tsf_L =
        new GeometricField<Type, fvsPatchField, surfaceMesh>
        (
            IOobject
            (
                "reconstructL("+vf.name()+')',
                vf.instance(),
                vf.db()
            ),
            mesh,
            vf.dimensions()
        );
    tsf_R =
        new GeometricField<Type, fvsPatchField, surfaceMesh>
        (
            IOobject
            (
                "reconstructR("+vf.name()+')',
                vf.instance(),
                vf.db()
            ),
            mesh,
            vf.dimensions()
        );
    GeometricField<Type, fvsPatchField, surfaceMesh>& sf_L = tsf_L.ref();
    GeometricField<Type, fvsPatchField, surfaceMesh>& sf_R = tsf_R.ref();

    Field<Type>& sfi_L = sf_L.primitiveFieldRef();
    Field<Type>& sfi_R = sf_R.primitiveFieldRef();

    const surfaceVectorField &faceCenter = mesh.Cf();
    const volVectorField &cellCenter = mesh.C();

    const GeometricField <typename outerProduct<vector, Type>::type, fvPatchField, volMesh> fgrad = fvc::grad(vf, "Gauss linear");
    const Field<typename outerProduct<vector, Type>::type> &fgradi = fgrad.internalField();

    for (label fi=0; fi<P.size(); fi++)
    {

        vector drtP = faceCenter[fi] - cellCenter[P[fi]];
        vector drtN = faceCenter[fi] - cellCenter[N[fi]];

        sfi_L[fi] = vfi[P[fi]] + (drtP&fgradi[P[fi]]);
                
        sfi_R[fi] = vfi[N[fi]] + (drtN&fgradi[N[fi]]);
                  
    }


    // Interpolate across coupled patches using given lambdas
    typename GeometricField<Type, fvsPatchField, surfaceMesh>::
        Boundary& sfbf_L = sf_L.boundaryFieldRef();
    typename GeometricField<Type, fvsPatchField, surfaceMesh>::
        Boundary& sfbf_R = sf_R.boundaryFieldRef();

    forAll(vf.boundaryField(), pi)
    {
/*        if (vf.boundaryField()[pi].coupled())
        {
            sfbf_L[pi] = vf.boundaryField()[pi].patchInternalField();
        
            sfbf_R[pi] = vf.boundaryField()[pi].patchNeighbourField();*/
        if (vf.boundaryField()[pi].coupled())
        {
           Field<Type> intL = vf.boundaryField()[pi].patchInternalField()();
           Field<Type> intR = vf.boundaryField()[pi].patchNeighbourField()();
           Field<typename outerProduct<vector, Type>::type> gradL = fgrad.boundaryField()[pi].patchInternalField()();
           Field<typename outerProduct<vector, Type>::type> gradR = fgrad.boundaryField()[pi].patchNeighbourField()();
           Field<vector> centerL = cellCenter.boundaryField()[pi].patchInternalField()();
           Field<vector> centerR = cellCenter.boundaryField()[pi].patchNeighbourField()();

           forAll(vf.boundaryField()[pi], fi)
           {
/*               dimensioned<vector> face_center = faceCenter.boundaryField()[pi][fi];

               //Get cell center
               dimensioned<vector> leftCenter  = centerL[fi];
               dimensioned<vector> rightCenter = centerR[fi];

               dimensioned<vector> drtP = face_center - leftCenter;
               dimensioned<vector> drtN = face_center - rightCenter;

               sfbf_L[pi][fi] = intL[fi];
               sfbf_L[pi][fi] = intL[fi]
                              + (drtP&gradL[fi]).value();
          
               sfbf_R[pi][fi] = intR[fi]
                              + (drtN&gradR[fi]).value();
*/
               point face_center = faceCenter.boundaryField()[pi][fi];

               //Get cell center
               point leftCenter  = centerL[fi];
               point rightCenter = centerR[fi];

               vector drtP = face_center - leftCenter;
               vector drtN = face_center - rightCenter;

               sfbf_L[pi][fi] = intL[fi]
                              + (drtP&gradL[fi]);
          
               sfbf_R[pi][fi] = intR[fi]
                              + (drtN&gradR[fi]);
           }
        }
      
        else
        {
            sfbf_L[pi] = vf.boundaryField()[pi];
            sfbf_R[pi] = vf.boundaryField()[pi];
        }
    }

}
